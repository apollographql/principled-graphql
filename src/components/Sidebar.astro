---
import {getChapters} from '../lib/nav';

interface Props {
  pathname: string;
}

const {pathname} = Astro.props;
const chapters = await getChapters();
---

<aside class="sidebar" id="sidebar">
  <a class="sidebar-logo" href="/"><h4>Principled GraphQL</h4></a>
  <nav>
    {
      chapters.map(chapter => (
        <div class="chapter">
          <a
            class:list={['chapter-title', {active: pathname === chapter.path}]}
            href={chapter.path}
          >
            {chapter.title}
          </a>
          <ul>
            {chapter.sections.map(section => (
              <li>
                <a href={section.path}>{section.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
  <h4 class="cta-heading">
    Learn how to apply these ten principles with the Apollo Graph Platform
  </h4>
  <a
    class="cta-button"
    href="https://apollographql.com?utm_medium=website&utm_source=principledgraphql.com&utm_campaign=sidebar-cta&utm_content=sidebar"
    target="_blank"
    rel="noopener noreferrer">Get Started</a
  >
</aside>

<style>
  .sidebar {
    flex-shrink: 0;
    width: var(--sidebar-width);
    height: 100vh;
    padding: 24px;
    border-right: 1px solid var(--divider);
    overflow-y: auto;
    position: sticky;
    top: 0;
    background-color: white;
  }

  .sidebar-logo {
    color: var(--text1);
    text-decoration: none;
  }

  .sidebar-logo h4 {
    margin-top: 0;
    margin-bottom: 24px;
  }

  .chapter {
    margin-bottom: 24px;
  }

  .chapter-title {
    display: block;
    padding: 12px 0;
    color: var(--text1);
    font-weight: bold;
    font-size: 14px;
    line-height: 15px;
    letter-spacing: 0.142em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .chapter-title:hover,
  .chapter-title.active {
    color: var(--primary);
  }

  .chapter ul {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .chapter li {
    font-size: 1rem;
  }

  .chapter li a {
    color: var(--text2);
    text-decoration: none;
  }

  .chapter li a:hover {
    color: var(--primary);
  }

  .cta-heading {
    line-height: 24px;
  }

  .cta-button {
    display: inline-block;
    padding: 12px 34px;
    border-radius: 4px;
    background: var(--primary);
    color: #fff;
    text-decoration: none;
  }

  .cta-button:hover {
    background: var(--primary-dark);
  }

  /* Off-canvas below the breakpoint; the header's menu button toggles [data-open]. */
  @media (max-width: 850px) {
    .sidebar {
      position: fixed;
      z-index: 2;
      height: 100%;
      box-shadow: 0 0 48px rgba(0, 0, 0, 0.25);
      opacity: 0;
      visibility: hidden;
      transform: translateX(-100%);
      transition: transform 150ms ease-in-out, opacity 150ms ease-in-out,
        visibility 150ms ease-in-out;
    }

    .sidebar[data-open] {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }
</style>
